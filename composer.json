{
  "name": "shreesoftech-rupesh/laravel-database-encryption",
  "description": "Auto Encrypt and Decrypt Database through Eloquent",
  "type": "library",
  "license": "MIT",
  "authors": [
    {
      "name": "rupesh",
      "email": "rupesh@shreesoftech.com"
    }
  ],
  "require": {},
  "autoload": {
    "psr-4": {
      "ShreeSoftech\\DBEncryption\\": "src"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "ShreeSoftech\\DBEncryption\\Tests\\": "tests",
      "ShreeSoftech\\DBEncryption\\Tests\\Database\\Factories\\": "tests/database/factories"
    }
  },
  "require-dev": {
    "orchestra/testbench": "^6.0",
    "phpunit/phpunit": "^9.4"
  },
  "extra": {
    "laravel": {
      "providers": [
        "ShreeSoftech\\DBEncryption\\Providers\\DBEncryptionServiceProvider"
      ]
    }
  },
  "scripts": {
    "test": "vendor/bin/phpunit",
    "test-f": "vendor/bin/phpunit --filter"
  }
}